{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "python-dev",
      "displayName": "Python extension and native tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/python-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HPC_BUILD_PYTHON": "ON",
        "HPC_BUILD_INFERENCE": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Full optimized build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HPC_BUILD_PYTHON": "ON",
        "HPC_BUILD_INFERENCE": "ON",
        "ONNXRUNTIME_ROOT": "$env{ONNXRUNTIME_ROOT}",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "python-dev", "configurePreset": "python-dev"},
    {"name": "release", "configurePreset": "release"}
  ],
  "testPresets": [
    {"name": "python-dev", "configurePreset": "python-dev", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}}
  ]
}
